---
import PageShell from '../../layouts/PageShell.astro';

// Your site lives under /journal, so build image paths from the base URL.
// This strips any trailing slash so we don't end up with "//".
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<PageShell title="Gallery" description="my photos arranged across the night sky" hideFooter>
  <img class="sky" src={`${base}/milky_way.jpg`} alt="The Milky Way" />
</PageShell>

<style>
  .sky {
    display: block;
    width: 100%;
    /* Fill the screen below the header. Change 64px to your header's real height. */
    height: calc(100vh - 64px);
    object-fit: cover;
    background-color: #000;
  }
</style>