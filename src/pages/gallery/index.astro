---
import PageShell from '../../layouts/PageShell.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<PageShell title="Gallery" description="my photos arranged across the night sky" hideFooter>
  <img class="sky" src={`${base}/milky_way.jpg`} alt="The Milky Way" />
</PageShell>

<style>
  .sky {
    display: block;
    width: 100%;
    height: 100dvh;
    object-fit: cover;
    background-color: #000;
  }
</style>